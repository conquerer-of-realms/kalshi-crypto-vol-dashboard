{
  "name": "kalshi-crypto-vol-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Free, public, no-login dashboard applying Kalshi macro-contract repricing signals to cryptocurrency realized volatility.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.app.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b tsconfig.app.json tsconfig.node.json tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "data:update": "tsx scripts/generate-dashboard-data.ts",
    "data:fixture": "tsx scripts/fixtures/generate-fixture.ts"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
